<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/bl_img"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/bl_green" />

    <ImageView
        android:id="@+id/wifi_img"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="7dp"
        android:src="@drawable/wifi_green" />

    <ImageView
        android:id="@+id/hand_img"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="7dp"
        android:src="@drawable/ic_autounlock_active" />

    <TextView
        android:id="@+id/title"
        style="@style/WidgetNotificationTitle"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/gray3"
        android:textSize="20sp"
        tools:text="name" />

    <ImageView
        android:id="@+id/toggle"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:maxHeight="90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_unlock" />

</LinearLayout>